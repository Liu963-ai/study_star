# 语音缓存：可再生（首次点击自动重新合成），不纳入版本管理
tts_cache/

# ---------- 本机生成物 / 构建中间件（可再生，不入版本管理） ----------
__pycache__/
*.pyc
# 安全钩子的本机运行状态
.mimosa/

